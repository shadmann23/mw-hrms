# ============================================================
# MilkWays Limited HRMS — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Django
SECRET_KEY=replace-with-a-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=your-app-name.up.railway.app

# Timezone (e.g. Asia/Dhaka, America/New_York, Europe/London)
TIME_ZONE=Asia/Dhaka

# PostgreSQL
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=strong-password-here
DB_HOST=localhost
DB_PORT=5432

# Email (set to console for dev, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# SSL — set False if your server handles SSL termination at proxy level
SECURE_SSL_REDIRECT=False
